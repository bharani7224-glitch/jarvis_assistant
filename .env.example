# ============================================================
# Jarvis .env  –  copy this file to .env and fill in your keys
# ============================================================

# ---- LLM provider: groq (default, fastest) | gemini | claude ----
LLM_PROVIDER=groq

# Groq – get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (used if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Anthropic Claude (used if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- STT: google (default, cloud, zero local RAM)
#          whisper (local, needs faster-whisper installed) ----
STT_ENGINE=google
GOOGLE_STT_LANGUAGE=en-IN

# Whisper overrides (only used when STT_ENGINE=whisper)
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu

# ---- VAD: energy (default, pure RMS, zero extra deps)
#          silero (better accuracy, needs silero-vad + torch installed) ----
VAD_ENGINE=energy

# ---- Wake word (lightweight ONNX, runs fully offline) ----
WAKE_WORD_ENABLED=true
# WAKE_THRESHOLD=0.5           # lower = more sensitive (more false triggers)

# ---- TTS ----
TTS_ENGINE=edge
TTS_VOICE=en-IN-PrabhatNeural

# ---- Misc ----
# HOTKEY=ctrl+space
# LOG_LEVEL=INFO
# LLM_TIMEOUT=10               # strict HTTP timeout in seconds
