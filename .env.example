# Copy to .env and fill in. Pick ONE provider.
LLM_PROVIDER=gemini            # gemini | claude

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Wake word / VAD (Phase 2) ----
# WAKE_WORD_ENABLED=true
# WAKE_THRESHOLD=0.5           # lower = more sensitive (more false triggers)
# VAD_ENGINE=silero            # silero | energy
# SILERO_THRESHOLD=0.5

# ---- Optional overrides ----
# STT_ENGINE=whisper           # whisper | google
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu           # cpu | cuda
# TTS_ENGINE=edge              # edge | offline
# TTS_VOICE=en-IN-PrabhatNeural
# HOTKEY=ctrl+space
# LOG_LEVEL=INFO
